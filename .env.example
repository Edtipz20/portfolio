# Neon connection string (use the "pooled" one Neon gives you)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Used once by `npm run db:seed` to create your first admin login.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Powers image uploads in /admin/projects. Get this from your UploadThing
# dashboard (Settings -> API Keys).
UPLOADTHING_TOKEN=""